{
  "name": "p4-scheduler",
  "productName": "Encadrement projet",
  "version": "1.2.2",
  "description": "Lecture d'agendas iCal, planning en liste, periodes communes, et affectation des enseignants aux seances de projet (P4)",
  "main": "main.js",
  "author": "antoine.pietri@u-bordeaux.fr",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke.js",
    "smoke": "electron . --smoke --no-sandbox",
    "icon": "node scripts/gen-icon.js calendar",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "ical.js": "^1.5.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "fr.ubordeaux.encadrement-projet",
    "productName": "Encadrement projet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "scripts/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Encadrement projet"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
